# ── Backend ──────────────────────────────
# Local:      http://localhost:5000
# Production: https://assingment4-nu.vercel.app   (no trailing slash)
BACKEND_API_URL=http://localhost:5000

# ── JWT ──────────────────────────────────
# MUST be exactly the same value as JWT_ACCESS_SECRET on the backend,
# otherwise proxy.ts cannot verify the token and every login redirects back to /login.
JWT_ACCESS_SECRET=your_jwt_access_secret

# ── App ──────────────────────────────────
# Local:      http://localhost:3000
# Production: https://<your-frontend>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
